# Non-secret settings, committed. Secrets live in .env (see .env.example).
LLM_PROVIDER=openai_compatible
LLM_MODEL=Qwen/Qwen3-8B
LLM_CA_CERT_PATH=certs/ca.crt
LLM_MAX_CONCURRENCY=1
LLM_REQUESTS_PER_MINUTE=50
LLM_TIMEOUT_SECONDS=120

# Ingestion: aim for chunks of CHUNK_TARGET_CHARS, never starting a paragraph-split above
# CHUNK_MAX_CHARS; chapters shorter than SHORT_CHAPTER_CHARS are treated as poems.
CHUNK_TARGET_CHARS=500
CHUNK_MAX_CHARS=1800
SHORT_CHAPTER_CHARS=3500

# LLM ingestion stages: a story chapter is cut into beats of about BEAT_TARGET_CHARS (never
# under BEAT_MIN_CHARS or over BEAT_MAX_CHARS). The model sees SEGMENT_WINDOW_PARAGRAPHS
# paragraph openings per call, and a failed validation is retried INGEST_RETRIES times.
BEAT_TARGET_CHARS=3500
BEAT_MIN_CHARS=1800
BEAT_MAX_CHARS=6500
SEGMENT_WINDOW_PARAGRAPHS=60
INGEST_RETRIES=2

# Agent: passages given to the model, its answer length cap, and the longest child message.
RETRIEVAL_TOP_K=6
GENERATION_MAX_TOKENS=200
MAX_CHILD_INPUT_CHARS=300

# Hybrid retrieval (modes M2, M2S): BM25 and embeddings each propose RETRIEVAL_CANDIDATES
# chunks, and reciprocal rank fusion (constant RRF_K) picks the top RETRIEVAL_TOP_K.
# Embeddings come from the course's embedding endpoint (OpenAI-style, bge-small-en-v1.5, at most
# EMBEDDING_BATCH_SIZE texts per request, each cut to EMBEDDING_MAX_CHARS to stay under its
# 512-token limit, its own CA certificate). Its URL and key go in .env as
# EMBEDDING_BASE_URL and EMBEDDING_API_KEY. EMBEDDING_QUERY_PREFIX, if set, is put in front of
# search questions only. EMBEDDING_CONTEXT_CHARS: each chunk's vector is made from the chunk plus
# the text around it in its scene, up to this many characters (0 = the chunk alone); changing it
# needs `make embed` again. For Gemini instead: EMBEDDING_PROVIDER=gemini,
# EMBEDDING_MODEL=gemini-embedding-001, EMBEDDING_DIM=768 and GEMINI_API_KEY in .env.
RETRIEVAL_CANDIDATES=20
RRF_K=60
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CHARS=1600
EMBEDDING_CONTEXT_CHARS=1200
EMBEDDING_CA_CERT_PATH=certs/vm02-ca.crt
EMBEDDING_QUERY_PREFIX=
EMBEDDING_REQUESTS_PER_MINUTE=30

# Play (API and web UI): the mode used for a child's free-text questions (M2S needs the
# embeddings, otherwise it falls back to M1S), and a cap on questions per session with a minimum
# gap between them. Only published books can be played.
# Where the API looks for books (comma-separated folders): one subfolder per book with raw.txt (a
# Project Gutenberg plain-text file) and book.yaml (gutenberg_id, title, author). A book dropped
# into `books/` shows up in the library, and choosing a chapter prepares it with the model
# (INGEST_IN_API=false leaves that to `make worker`). eval/books holds the Jungle Book fixture.
BOOKS_DIR=books,eval/books
INGEST_IN_API=true
PLAY_MODE=M2S
MAX_QUESTIONS_PER_SESSION=10
ASK_MIN_INTERVAL_SECONDS=2
API_DEBUG=false

DATA_DIR=var
API_PORT=8000
DBVIEWER_PORT=8001
