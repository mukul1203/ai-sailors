# Non-secret settings, committed. Secrets live in .env (see .env.example).
LLM_PROVIDER=openai_compatible
LLM_MODEL=Qwen/Qwen3-8B
LLM_CA_CERT_PATH=certs/ca.crt
LLM_MAX_CONCURRENCY=1
LLM_REQUESTS_PER_MINUTE=50
LLM_TIMEOUT_SECONDS=120

# Ingestion: aim for chunks of CHUNK_TARGET_CHARS, never starting a paragraph-split above
# CHUNK_MAX_CHARS; chapters shorter than SHORT_CHAPTER_CHARS are treated as poems.
CHUNK_TARGET_CHARS=1200
CHUNK_MAX_CHARS=1800
SHORT_CHAPTER_CHARS=8000

DATA_DIR=var
API_PORT=8000
DBVIEWER_PORT=8001
