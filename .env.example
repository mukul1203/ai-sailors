# Secrets only. Copy to .env (git-ignored) and fill in. Settings belong in config.env.
# The model endpoint URL (IP and port) counts as a secret. The CA certificate goes in certs/ca.crt (git-ignored).
LLM_API_KEY=
LLM_BASE_URL=
# Embeddings for hybrid retrieval (modes M2, M2S). The course's embedding endpoint (default,
# EMBEDDING_PROVIDER=openai_compatible): its URL ends in /v1, and its own CA certificate goes in
# certs/vm02-ca.crt (git-ignored).
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Only for EMBEDDING_PROVIDER=gemini: a Gemini API key from Google AI Studio. Free tier is for
# development only.
GEMINI_API_KEY=
SESSION_SECRET=
